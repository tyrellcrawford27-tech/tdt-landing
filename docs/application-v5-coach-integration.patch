diff --git a/lib/db/migrations/2026-09-11-application-v5.sql b/lib/db/migrations/2026-09-11-application-v5.sql
new file mode 100644
--- /dev/null
+++ b/lib/db/migrations/2026-09-11-application-v5.sql
@@ -0,0 +1,13 @@
+-- Additive only. Apply before deploying the v5 public form or coach API.
+-- Keep existing v4 answers, progress columns, defaults and constraints intact.
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '30s';
+ALTER TABLE public.applications
+  ADD COLUMN IF NOT EXISTS film_readiness TEXT,
+  ADD COLUMN IF NOT EXISTS film_access TEXT,
+  ADD COLUMN IF NOT EXISTS decision_support TEXT,
+  ADD COLUMN IF NOT EXISTS guardian_consent TEXT,
+  ADD COLUMN IF NOT EXISTS investment_readiness TEXT;
+NOTIFY pgrst, 'reload schema';
+COMMIT;
diff --git a/artifacts/tdt-app/tests/application-progress-v5.test.mjs b/artifacts/tdt-app/tests/application-progress-v5.test.mjs
new file mode 100644
--- /dev/null
+++ b/artifacts/tdt-app/tests/application-progress-v5.test.mjs
@@ -0,0 +1,81 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { registerHooks } from 'node:module';
+registerHooks({
+  resolve(specifier, context, next) {
+    if (specifier === './application-insights') return {url:new URL('./application-insights.ts',context.parentURL).href,shortCircuit:true};
+    return next(specifier,context);
+  },
+});
+const {applicationProgress, applicationQuestionAnswers, usesNewApplicationQuestions} = await import('../src/lib/application-progress.ts');
+const row = (changes = {}) => ({
+  application_state:'draft', form_version:5, age:17, created_at:'2026-09-11T12:00:00Z',
+  current_question_key:'goal', current_question_number:2, current_question_label:'Where would you like basketball to take you?',
+  total_questions:16, goal:'Play professionally', ...changes,
+});
+
+test('v4 keeps its original descriptors; v5 uses the goal-first order', () => {
+  assert.equal(applicationQuestionAnswers(row({form_version:4})).find(q=>q.key==='goal').number,10);
+  const progress=applicationProgress(row());
+  assert.equal(progress.current.key,'goal');
+  assert.equal(progress.current.number,2);
+  assert.equal(progress.current.answers[0].value,'Play professionally');
+});
+
+test('old and unversioned records never acquire new question labels or qualification fields', () => {
+  const original=applicationQuestionAnswers(row({form_version:4,goal:'Original essay'}));
+  for(const version of [undefined,null,0,3,4]) {
+    const app=row({form_version:version,goal:'Original essay'});
+    const before=structuredClone(app);
+    assert.equal(usesNewApplicationQuestions(app),false);
+    assert.deepEqual(applicationQuestionAnswers(app),original);
+    assert.equal(applicationQuestionAnswers(app).length,14);
+    assert.equal(applicationQuestionAnswers(app).some(q=>q.key==='film_readiness'||q.key==='investment_readiness'),false);
