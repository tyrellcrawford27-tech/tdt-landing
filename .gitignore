# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local config and worktrees
.claude/

# Source/original media kept locally — the app ships the .webp exports
*-original-backup*
*.mov
/public/Drill Library 3.png
/public/diagnosis-1.png
/public/the-100-days.png

# Full-res source images kept for re-export, not served. The site uses the
# derived webp in public/; regenerate them with sharp, e.g.
#   sharp(src).resize({width: 1900}).webp({quality: 72}).toFile('public/hero-N.webp')
#   sharp(src).resize({width: 1000}).webp({quality: 70}).toFile('public/hero-N-sm.webp')
/design-assets
