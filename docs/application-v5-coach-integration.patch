+test('conditional paths keep stable identities and the saved visible count', () => {
+  for(const adult of [false,true]) for(const decline of [false,true]) {
+    const app=row({
+      age:adult?20:17, decision_support:adult?"I'm deciding for myself":'A parent or guardian',
+      film_readiness:decline?"I don't want film coaching right now":"I'd like that kind of coaching",
+      total_questions:16-Number(adult)-Number(decline),
+      current_question_key:'heard_about',current_question_number:16-Number(adult)-Number(decline),current_question_label:'How did you hear about us?',
+    });
+    const progress=applicationProgress(app);
+    assert.equal(progress.questions.length,app.total_questions);
+    assert.equal(progress.current.key,'heard_about');
+    assert.equal(progress.totalQuestions,app.total_questions);
+  }
+});
